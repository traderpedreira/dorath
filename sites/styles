:root{color-scheme:dark;--bg:#0d0b08;--panel:#17120c;--panel2:#211910;--ink:#f4ead7;--muted:#b8a991;--gold:#d1a74f;--line:#403322;--danger:#ff9d8e;--ok:#7ecf8a}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at top,#261d12 0,#0d0b08 42%);color:var(--ink);font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;min-height:100vh}.shell{max-width:820px;margin:auto;padding:18px 16px 60px}.topbar,.statusline,.section-head,.turn-panel,.position-panel,.modal-head{display:flex;justify-content:space-between;align-items:center;gap:12px}.topbar{margin-bottom:18px}.topbar h1,.panel h2{margin:.15rem 0}.eyebrow{font-size:.72rem;letter-spacing:.16em;color:var(--gold);margin:0;text-transform:uppercase}.muted{color:var(--muted)}.mini{font-size:.82rem}.panel,.subpanel{background:rgba(23,18,12,.92);border:1px solid var(--line);border-radius:18px;padding:18px;margin-bottom:16px}.subpanel{background:#100c08;margin:14px 0}.stack{display:grid;gap:10px}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin:16px 0}.action-card{min-height:132px;text-align:left;display:flex;flex-direction:column;justify-content:center;gap:7px;background:linear-gradient(145deg,#211910,#15100b);border:1px solid var(--line);border-radius:18px;color:var(--ink);padding:16px}.action-card.featured{border-color:#8b6e38;box-shadow:inset 0 0 0 1px #d1a74f33}.action-card strong{font-size:1.05rem}.action-card small{color:var(--muted)}.big-icon{font-size:2rem}.primary,.secondary,.icon-btn,.text-btn,.choice{border:0;border-radius:12px;padding:12px 16px;font-weight:700;cursor:pointer}.primary{background:var(--gold);color:#1b1208;width:100%}.secondary,.choice{background:#2a2117;color:var(--ink);border:1px solid #59472f}.icon-btn{background:#2a2117;color:var(--ink);font-size:1.15rem;padding:10px 13px}.text-btn{background:transparent;color:var(--gold);padding:4px}.hidden{display:none!important}label{display:grid;gap:7px;color:var(--muted);font-size:.92rem}input,select,textarea{width:100%;background:#0e0b08;color:var(--ink);border:1px solid var(--line);border-radius:12px;padding:12px;font-size:1rem}textarea{min-height:84px}.resource-inputs{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.statusline{padding:0 4px;color:var(--muted);font-size:.9rem}.resource-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:12px 0 16px}.resource-chip{background:#100c08;border:1px solid var(--line);border-radius:14px;padding:10px;text-align:center}.resource-chip strong{display:block;font-size:1.25rem;color:var(--gold)}.player-cards{display:grid;grid-template-columns:1.1fr 1fr 1fr;gap:10px;margin:14px 0}.summary-card{background:rgba(23,18,12,.92);border:1px solid var(--line);border-radius:18px;overflow:hidden}.summary-card.player{padding:14px;display:grid;gap:8px;align-content:start}.summary-card.player .name{font-size:1.1rem;font-weight:800}.summary-card.player .pill{display:inline-block;background:#2a2117;border:1px solid #59472f;border-radius:999px;padding:5px 8px;font-size:.74rem}.char-mini{position:relative;aspect-ratio:63/88;background:#0f0c09}.char-mini img{display:block;width:100%;height:100%;object-fit:cover}.char-mini .empty{position:absolute;inset:0;display:grid;place-items:center;padding:12px;text-align:center;color:var(--muted)}.char-mini .caption{position:absolute;left:0;right:0;bottom:0;padding:8px;background:linear-gradient(transparent,#000e);font-size:.78rem;font-weight:700}.log-panel ol{padding-left:1.35rem;margin-bottom:0}.log-panel li{margin:.45rem 0;color:var(--muted)}dialog{width:min(94vw,680px);max-height:90vh;overflow:auto;background:#17120c;color:var(--ink);border:1px solid #59472f;border-radius:20px;padding:0 18px 20px;box-shadow:0 24px 80px #000a}dialog::backdrop{background:#000b}.modal-head{position:sticky;top:0;background:#17120c;padding:16px 0;z-index:3}.notice{background:#2a2117;border-left:3px solid var(--gold);padding:12px 14px;border-radius:8px}.error{color:var(--danger)}.ok{color:var(--ok)}.badge-row{display:flex;gap:8px;flex-wrap:wrap}.badge{display:inline-block;background:var(--gold);color:#1b1208;border-radius:999px;padding:5px 9px;font-size:.75rem;font-weight:800}.muted-badge{background:#302619;color:var(--ink)}.die-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:14px 0}.die-grid button{font-size:1.5rem;min-height:58px}.move-preview{display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:center;text-align:center;background:#100c08;border:1px solid var(--line);padding:14px;border-radius:14px}.move-preview strong{font-size:1.25rem}.occurrence{background:#100c08;border:1px solid var(--line);border-radius:16px;padding:16px;margin:10px 0}.occurrence h3{margin:.3rem 0}.card-ref{display:grid;grid-template-columns:120px 1fr;gap:14px;align-items:start}.card-ref img{width:100%;border-radius:10px;border:1px solid var(--line)}.resource-table{display:grid;gap:8px}.resource-row{display:grid;grid-template-columns:1fr 90px 90px;gap:8px;align-items:center}.char-list{display:grid;gap:10px}.char-option{display:flex;gap:10px;align-items:flex-start;background:#100c08;border:1px solid var(--line);border-radius:12px;padding:10px;color:var(--ink)}.char-option input{width:auto;margin-top:8px}.char-option img{width:70px;border-radius:8px;border:1px solid var(--line)}.char-option span{flex:1}.tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:5px}.tags em{font-style:normal;font-size:.7rem;background:#2a2117;border:1px solid #59472f;border-radius:999px;padding:3px 6px}.trade-box,.history-card{background:#100c08;border:1px solid var(--line);border-radius:14px;padding:14px;margin:10px 0}.trade-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.item-list{display:flex;flex-wrap:wrap;gap:7px}.item-pill{background:#2a2117;border:1px solid #59472f;border-radius:999px;padding:6px 9px}.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}.rule{padding:12px 0;border-bottom:1px solid var(--line)}.rule:last-child{border-bottom:0}
@media(max-width:620px){.grid{grid-template-columns:1fr 1fr}.player-cards{grid-template-columns:1fr 1fr}.summary-card.player{grid-column:1/-1}.resource-inputs,.resource-strip{grid-template-columns:1fr 1fr}.position-panel,.turn-panel{align-items:flex-start;flex-direction:column}.position-panel button,.turn-panel button{width:100%}.trade-grid,.two{grid-template-columns:1fr}.card-ref{grid-template-columns:90px 1fr}.resource-row{grid-template-columns:1fr 70px 70px}}

.global-state-list{display:grid;gap:8px;margin:10px 0}.state-card{background:#100c08;border:1px solid #59472f;border-radius:12px;padding:10px}.state-card strong{color:var(--gold)}.state-card.inactive{opacity:.62}.marco-full{display:grid;gap:14px}.marco-full img{width:min(100%,360px);max-height:64vh;object-fit:contain;margin:auto;display:block;border-radius:12px;border:1px solid var(--line)}.marco-actions{display:grid;gap:9px}.world-strip{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0}.world-pill{background:#26150f;border:1px solid #6f3d32;border-radius:999px;padding:6px 9px;font-size:.8rem}.benefit-box{background:#15100b;border:1px solid var(--line);border-radius:12px;padding:10px;margin:8px 0}.card-copy{font-size:.9rem;color:var(--muted);line-height:1.42}.card-copy b{color:var(--ink)}
